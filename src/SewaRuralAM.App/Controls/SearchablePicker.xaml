<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="SewaRuralAM.App.Controls.SearchablePicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SewaRuralAM.App.Controls">

    <VerticalStackLayout>
        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                Padding="14,0" HeightRequest="46">
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="DisplayLabel" Grid.Column="0" VerticalOptions="Center" FontSize="14" LineBreakMode="TailTruncation" />
                <Label x:Name="ChevronLabel" Grid.Column="1" Text="{x:Static local:IconGlyphs.ExpandMore}" FontFamily="MaterialIcons" FontSize="18" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeaderTapped" />
            </Border.GestureRecognizers>
        </Border>

        <Border x:Name="DropdownPanel" IsVisible="False" Margin="0,4,0,0"
                StrokeShape="RoundRectangle 10" StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Padding="0">
            <VerticalStackLayout>
                <SearchBar x:Name="FilterSearchBar" Placeholder="Search…" TextChanged="OnSearchTextChanged" />
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                <CollectionView x:Name="ItemsView" HeightRequest="240" SelectionMode="Single" SelectionChanged="OnItemSelectionChanged">
                    <CollectionView.EmptyView>
                        <Label Text="No matches." Margin="14" Style="{StaticResource Caption}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding DisplayText}" FontSize="14" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="&#10003;" TextColor="{StaticResource Success}" IsVisible="{Binding IsSelected}" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
