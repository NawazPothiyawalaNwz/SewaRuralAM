<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SewaRuralAM.App.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SewaRuralAM.App.ViewModels"
    x:DataType="vm:ChangePasswordViewModel"
    Title="Change Password">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="420" HorizontalOptions="Center">
            <Label Text="Current Password" FontSize="13" Opacity="0.7" />
            <Entry Text="{Binding CurrentPassword}" IsPassword="True" />

            <Label Text="New Password" FontSize="13" Opacity="0.7" />
            <Entry Text="{Binding NewPassword}" IsPassword="True" />

            <Label Text="Confirm New Password" FontSize="13" Opacity="0.7" />
            <Entry Text="{Binding ConfirmPassword}" IsPassword="True" />

            <Button Text="Update Password" Command="{Binding SubmitCommand}" />

            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
