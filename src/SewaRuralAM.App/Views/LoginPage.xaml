<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SewaRuralAM.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SewaRuralAM.App.ViewModels"
    xmlns:controls="clr-namespace:SewaRuralAM.App.Controls"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <Grid Padding="20" RowDefinitions="*,Auto,*" MinimumHeightRequest="640">
            <Frame Grid.Row="1"
                   MaximumWidthRequest="380"
                   HorizontalOptions="Center"
                   Padding="32"
                   CornerRadius="18"
                   HasShadow="True"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="14">

                    <Image Source="logo.png" HeightRequest="88" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,0,0,4" />
                    <Label Text="Sewa Rural" FontFamily="PoppinsBold" FontSize="24" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="Asset Management System" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,0,0,10" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="User Name" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding UserName}" Placeholder="Enter user name" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Password" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Password}" Placeholder="Enter password" IsPassword="True" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding RememberMe}" />
                        <Label Text="Remember Me" VerticalOptions="Center" FontSize="13" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                    <Button Text="Sign In" Command="{Binding LoginCommand}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="{x:Static controls:IconGlyphs.Lock}" Color="White" Size="16" />
                        </Button.ImageSource>
                    </Button>
                    <Button Text="Forgot Password?" Command="{Binding ForgotPasswordCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Center" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>
