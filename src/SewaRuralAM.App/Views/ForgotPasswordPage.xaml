<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SewaRuralAM.App.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SewaRuralAM.App.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    Title="Forgot Password">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="420" HorizontalOptions="Center">
            <Label Text="User Name or Email" FontSize="13" Opacity="0.7" />
            <Entry Text="{Binding UserNameOrEmail}" Placeholder="Enter user name or email" />
            <Button Text="Request Reset Token" Command="{Binding RequestResetCommand}" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,12" IsVisible="{Binding TokenGenerated}" />

            <VerticalStackLayout Spacing="14" IsVisible="{Binding TokenGenerated}">
                <Label Text="Reset Token" FontSize="13" Opacity="0.7" />
                <Entry Text="{Binding ResetToken}" />

                <Label Text="New Password" FontSize="13" Opacity="0.7" />
                <Entry Text="{Binding NewPassword}" IsPassword="True" />

                <Button Text="Reset Password" Command="{Binding ResetPasswordCommand}" />
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
